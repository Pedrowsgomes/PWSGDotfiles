# --- Variáveis ---
set $mod Mod4
set $term alacritty
set $menu fuzzel
set $browser thunar

# --- Input ---
input * {
    xkb_layout br
    xkb_numlock enabled
}
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
}

# --- Visual SwayFX (Arredondado e Sem Títulos) ---
# Remove as barras de título clássicas, deixando apenas borda de 2px
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Configurações exclusivas do SwayFX (Rounded Corners & Shadows)
# corner_radius 10
# shadows on
# shadow_blur_radius 20
# shadow_color #000000
# Blur no fundo transparente (opcional, consome um pouco mais de GPU)
# blur enable
# blur_passes 2

gaps inner 2
gaps outer 0

# --- Cores (Monocromático) ---
# class                 border  backgr. text    indicator child_border
client.focused          #FFFFFF #000000 #FFFFFF #FFFFFF   #FFFFFF
client.focused_inactive #333333 #000000 #888888 #333333   #333333
client.unfocused        #333333 #000000 #888888 #333333   #333333
client.urgent           #FFFFFF #900000 #FFFFFF #900000   #900000

# --- Output ---
output * bg #000000 solid_color
output eDP-1 scale 1

# --- Idle e Bloqueio ---
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000 --ring-color ffffff' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# --- Início Automático ---
exec waybar
exec swaync
exec wl-paste --watch cliphist store
exec nm-applet --indicator
exec /usr/libexec/polkit-gnome-authentication-agent-1

# --- Atalhos ---
bindsym $mod+t exec $term
bindsym $mod+Return exec foot
bindsym $mod+d exec $menu
bindsym $mod+e exec $browser
bindsym $mod+Shift+q kill
bindsym $mod+Shift+space floating toggle
bindsym $mod+f fullscreen
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec wlogout
bindsym $mod+b exec pkill -USR1 waybar
bindsym $mod+Shift+b exec pkill waybar || waybar

# Clipboard / Notificações
bindsym $mod+v exec cliphist list | fuzzel --dmenu --prompt="Colar: " | cliphist decode | wl-copy
bindsym $mod+Shift+v exec cliphist list | fuzzel --dmenu --prompt="Apagar: " | cliphist delete
bindsym $mod+n exec swaync-client -t -sw

# Screenshot
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy && notify-send "Área Copiada"
bindsym Print exec grim - | wl-copy && notify-send "Tela Copiada"

# Audio / Brilho
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-

# Navegação
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces Mouse
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

# Workspaces 1-9
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

bindsym $mod+r mode "resize"
workspace_auto_back_and_forth yes
